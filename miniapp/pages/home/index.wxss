.home-page {
  min-height: 100vh;
  background: #f5f5f5;
}
.brand {
  padding: 60rpx 40rpx 48rpx;
  color: #fff;
}
.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}
.brand-title {
  font-size: 40rpx;
  font-weight: 600;
}
.brand-user {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.85;
}
.notice {
  margin: 24rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ad6800;
}
.login-area {
  padding: 60rpx 48rpx;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 32rpx 24rpx;
}
.grid-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.grid-item:active {
  opacity: 0.8;
}
.grid-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}
.grid-title {
  font-size: 26rpx;
  color: #333;
}
