.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #e8f8ee 0%, #f5f5f5 40%);
}

.brand-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 80rpx;
}

.brand-icon {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.35);
  margin-bottom: 32rpx;
}

.brand-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: #999;
}

.action-area {
  padding: 0 64rpx 120rpx;
}

.login-btn {
  margin-bottom: 24rpx;
}

.tips {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
