.list-page {
  min-height: 100vh;
  padding: 24rpx 0 200rpx;
}

.pay-item:active {
  opacity: 0.85;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-desc {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.item-status {
  font-size: 22rpx;
  color: #fa8c16;
  background: #fff7e6;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.item-mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-order {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

.item-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #e64545;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 32rpx;
  border-radius: 28rpx;
}

.mini-btn.cancel {
  color: #666;
  background: #f0f0f0;
}

.mini-btn.pay {
  color: #fff;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
}

.mini-btn::after {
  border: none;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c0c0c0;
}

.footer-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 40rpx 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  height: 80rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
