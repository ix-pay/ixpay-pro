.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
}
.page-header {
  padding: 24rpx 32rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
}
.nickname {
  font-size: 34rpx;
  font-weight: 600;
}
.uid {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.menu-card {
  padding: 0 32rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.arrow {
  color: #ccc;
}
.btn-area {
  padding: 48rpx 48rpx;
}
.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  border-radius: 44rpx;
  background: #fff;
  color: #e64545;
  font-size: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.logout-btn::after {
  border: none;
}
